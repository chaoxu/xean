{
  "name": "xean",
  "version": "4.5.0",
  "description": "Mathematical research on native Pi Durable with joint dependency reconstruction",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.4.2"
  },
  "bin": {
    "xean": "./apps/cli/index.ts"
  },
  "files": [
    "src/",
    "apps/",
    "scripts/",
    "examples/",
    "vendor/",
    "tests/",
    "docs/faq.md",
    "README.md",
    "release-notes.md",
    "CITATION.cff",
    "TODO.md",
    "AGENTS.md",
    "LICENSE",
    "bun.lock",
    "tsconfig.json",
    "patches/"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./policy": "./src/policy/index.ts",
    "./activity": "./src/activity.ts"
  },
  "scripts": {
    "check": "bun scripts/dev.ts check",
    "check:distribution": "bun scripts/dev.ts distribution",
    "pack": "bun scripts/dev.ts pack",
    "xean": "bun apps/cli/index.ts",
    "pi": "bun node_modules/.bin/pi"
  },
  "dependencies": {
    "@chaoxu/notebook-store": "file:vendor/notebook-store/chaoxu-notebook-store-0.1.0-c5c314b.tgz",
    "@earendil-works/chord": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-durable": "1.5.0",
    "commander": "15.0.0",
    "execa": "10.0.1",
    "zod": "4.5.4",
    "@earendil-works/pi-schema": "1.5.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "prettier": "3.9.9",
    "typescript": "7.0.2"
  },
  "patchedDependencies": {
    "@earendil-works/chord@1.5.0": "patches/@earendil-works%2Fchord@1.5.0.patch",
    "@earendil-works/pi-ai@1.5.0": "patches/@earendil-works%2Fpi-ai@1.5.0.patch",
    "@earendil-works/pi-durable@1.5.0": "patches/@earendil-works%2Fpi-durable@1.5.0.patch"
  }
}
