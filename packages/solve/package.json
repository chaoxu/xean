{
  "name": "xean-solve",
  "version": "1.1.1",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.13"
  },
  "bin": {
    "xean-solve": "./solve.ts"
  },
  "exports": {
    ".": "./solve.ts",
    "./roles": "./role-api.ts"
  },
  "files": [
    "*.ts",
    "LICENSE",
    "README.md",
    "docs",
    "examples"
  ],
  "scripts": {
    "format": "prettier --write . --ignore-path .prettierignore",
    "format:check": "prettier --check . --ignore-path .prettierignore",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "e2e:roles": "bun test tests/role-cli-e2e.test.ts",
    "pack:check": "bun scripts/check-package.ts",
    "check": "bun run format:check && bun run typecheck && bun run test && bun run pack:check && bun solve.ts --help"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "zod": "4.5.4"
  },
  "peerDependencies": {
    "xean": "^1.1.1"
  },
  "peerDependenciesMeta": {
    "xean": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "xean": "file:../..",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  }
}
